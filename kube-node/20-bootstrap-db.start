#!/bin/sh
# Phase 2 (db): ZFS, k3s agent.
[ -f /etc/local.d/20-bootstrap.done ] && exit 0
set -e
# Run under the local service, so log to a file and set a full PATH (the service
# environment is minimal — same reason 10-provision.start exports PATH).
exec >>/var/log/bootstrap.log 2>&1
export PATH="/usr/sbin:/usr/bin:/sbin:/bin:$PATH"

# dhcpcd backgrounds as soon as it configures any address, so the local service can start
# before the DHCP lease and resolv.conf land and apk fails to resolve the mirror.
i=0
until apk update -q >/dev/null 2>&1; do
  i=$((i + 1))
  [ "$i" -lt 60 ] || { echo "ERROR: no usable network after 2 minutes" >&2; exit 1; }
  sleep 2
done

apk add zfs-lts
modprobe zfs

POOL_DISKS="/dev/sda /dev/sdb /dev/sdc /dev/sdd"
case " $POOL_DISKS " in
  *" $(cat /etc/node-disk) "*)
    echo "ERROR: Alpine was installed to a pool disk; the db node needs an NVMe root" >&2
    exit 1
    ;;
esac
zpool create -f -o ashift=12 tablespaces raidz $POOL_DISKS
zfs set mountpoint=/mnt/tablespaces tablespaces

rc-update add zfs-import boot
rc-update add zfs-mount boot

for f in /sys/bus/usb/devices/*/power/autosuspend; do
  echo -1 > "$f"
done

apk add -q curl procps

cat > /etc/sysctl.d/99-k3s.conf <<EOF
kernel.panic=10
kernel.panic_on_oops=1
vm.overcommit_memory=1
EOF
sysctl -p /etc/sysctl.d/99-k3s.conf

# Volumes served over 9P are mounted by a userspace FUSE client: without the module there is
# no /dev/fuse for the CSI node plugin to open, and its hostPath mount fails before it starts.
modprobe fuse
echo fuse >> /etc/modules

mount --make-rshared /
cat > /etc/local.d/00-rshared.start <<'EOF'
#!/bin/sh
mount --make-rshared /
EOF
chmod +x /etc/local.d/00-rshared.start

K3S_TOKEN_FILE="/etc/k3s-token"
[ -f "$K3S_TOKEN_FILE" ] || { echo "ERROR: $K3S_TOKEN_FILE not found." >&2; exit 1; }

curl -sfL https://get.k3s.io | \
  K3S_URL="https://10.0.0.22:6443" \
  K3S_TOKEN="$(cat "$K3S_TOKEN_FILE")" \
  INSTALL_K3S_EXEC="--protect-kernel-defaults" \
  sh -

rc-service k3s-agent restart

touch /etc/local.d/20-bootstrap.done
echo "==> k3s db bootstrap complete. Run from control plane:"
echo "  kubectl label nodes $(hostname) node-role=database"
echo "  kubectl taint nodes $(hostname) workload=database:NoSchedule"
